# ---- 依赖 ----
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
# OTA 适配层的 python 环境（scripts/ota/cli.js 会自动找它）
.venv*/
__pycache__/
*.pyc

# ---- 运行时产物：planner.js 生成的报告 / 数据导出 ----
*.html
*.csv
out/
dist/
*.zip

# ---- 本地测试用 config 与临时文件 ----
_test*.json
_bad*.json
_*.json
_*.txt
_*.html
config.local.json
*.local.json
tmp/
.tmp/

# ---- 查询结果缓存（含票价快照，不入库）----
.cache/

# ---- 本地 agent 工作区（会话记忆、日志）----
.workbuddy-ai/

# ---- planner 的输入 config 与检索中间产物（含查到的票价，不入库）----
# 根目录不放 json：config 与航班数据都在本地生成
/*.json

# ---- 密钥与本地环境 ----
.env
.env.*
!.env.example
amap_key.txt

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志 ----
*.log
npm-debug.log*

# ---- 案例本地路径表（含具体票价/时刻，不入库；仓库里只有 network.example.json）----
references/network.json
network.json

# ---- 算例跑出来的东西（case.json / top.json / legs.json 都带当日票价，不入库）----
# 想留一份可复现的样本，就把 case.json 脱敏后放进 references/ 当示例。
cases/
